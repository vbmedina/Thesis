def flatten_synonyms(syn_dict):
    flat = {}
    for canon, alts in syn_dict.items():
        for alt in [canon, *alts]:
            key = re.sub(r'[\s\-_\/]+', '', alt).upper()
            flat[key] = canon
    return flat

strain_map = {**flatten_synonyms(lst_strains)}            

def canonicalise(label):
    if pd.isna(label):
        return np.nan
    key = re.sub(r'[\s\-_\/]+', '', str(label)).upper()
    return strain_map.get(key, np.nan)               

# ------------------------------------------------------------- load & tidy ----
raw = pd.read_csv(csv_path, low_memory=False)

df = (raw.query("`Standard Type`.str.upper() == 'IC50'", engine="python")
        .assign(
            strain   = lambda x: x["verify_strain"].map(canonicalise),  # ❹
            molecule = lambda x: x["Molecule Name"]
                                   .fillna(x["Molecule ChEMBL ID"]),
            ic50_nM  = lambda x: pd.to_numeric(x["Standard Value"],
                                               errors="coerce"))
        .dropna(subset=["ic50_nM", "strain"]))                          # ❺

# ------------------------------------------------------------ pIC50 matrix ----
# ic50_nM  = lambda x: pd.to_numeric(x["Standard Value"])
                                   
pivot = df.pivot_table(index="molecule",
                       columns="strain",
                       values="ic50_nM",
                       aggfunc="mean")                                  


pic50 = 9 - np.log10(pivot)         # ❻ convert nM ➜ pIC50  (–log10 M)

# trim to most complete rows/cols for the preview
if num_mols:
    pic50 = pic50.loc[pic50.notna().sum(1).nlargest(num_mols).index]
if num_strains:
    pic50 = pic50[pic50.notna().sum().nlargest(num_strains).index]

mask  = pic50.isna()
pic50_clust = pic50.fillna(pic50.median())           # light impute ⓘ only for clustering

# ------------------------------------------------------------- colours etc ----
sns.set_theme(context="notebook", style="white", font_scale=.8)
centre_val = 6                                        # pIC50=6 (~1 µM) = white

unique_strains = pic50_clust.columns
palette = sns.husl_palette(len(unique_strains), s=.75) # distinct hue per strain
col_colors = pd.Series(unique_strains, index=unique_strains).map(
                 dict(zip(unique_strains, palette)))

# ------------------------------------------------------------ clustermap ------
cg = sns.clustermap(pic50_clust,
                    cmap="RdBu_r",
                    norm=TwoSlopeNorm(vcenter=centre_val),
                    method="average", metric="correlation",
                    row_cluster=False, col_cluster=True,
                    mask=mask.loc[pic50_clust.index, pic50_clust.columns],
                    col_colors=col_colors,
                    figsize=(11, 13),
                    dendrogram_ratio=(.0, .1))#cbar_kws=dict(label="pIC50 (–log₁₀ M)"))

cg.ax_heatmap.set_xlabel("P. falciparum strain")
cg.ax_heatmap.set_ylabel("Molecule")
plt.setp(cg.ax_heatmap.get_xticklabels(), rotation=90)
plt.tight_layout()
plt.savefig(out_fig, dpi=400)
plt.show()